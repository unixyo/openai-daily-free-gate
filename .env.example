# Example environment for openai-daily-free-gate.
# Copy to .env (git-ignored) only if your own launcher loads it.
# gate.py itself reads ONLY GATE_UPSTREAM; it never reads an API key.

# Upstream API base URL the gateway forwards to.
GATE_UPSTREAM=https://api.openai.com

# Your OpenAI client (not the gateway) sends this key in its Authorization
# header. Placeholder only -- never commit a real key.
OPENAI_API_KEY=sk-REPLACE_ME

# Point your OpenAI-compatible client at the local gateway.
OPENAI_BASE_URL=http://127.0.0.1:18765/v1
